# Copy this file to .env.backoffice.dev and fill in the values

# Same database as the main Flask app
DATABASE_URL=postgresql://USER:PASSWORD@dbserver:5432/DBNAME

# Must match the SECRET_KEY in .env.dev
SECRET_KEY=your-secret-key-here

# Set on new CarrierCompany rows at self-registration time (backoffice-api/app/utils.py).
# Must match COUNTRY_ID in the main app's .env — a carrier left with country_id=NULL
# never receives order notifications (email or WhatsApp), even once activated.
COUNTRY_ID=2

FLASK_ENV=development
FLASK_APP=run.py

# Optional. Only set in .env.backoffice.prod on the server — leaving it unset
# here keeps Sentry a no-op locally, so dev/test errors never get reported.
SENTRY_DSN=

# Configuración de correo. OJO: el backoffice-api NO comparte el entorno del
# API principal, así que tener esto en .env.prod no alcanza — hay que
# repetirlo aquí o los avisos del backoffice (p. ej. "Nuevo transportista
# registrado") no salen. Mismo buzón/SES que .env.dev.
# Sin MAIL_SERVER, MAIL_SENDER o ADMIN_MAIL el contenedor arranca igual y lo
# avisa en sus logs al iniciar.
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_USE_TLS=
# Destinatario de los avisos al equipo.
ADMIN_MAIL=

# Deben coincidir con .env.dev: el backoffice-api recalcula precios de
# cotización y sin esto cae a los defaults del código, mostrando totales
# distintos a los que ve el cliente en el front.
PLATFORM_FEE=
IGV_RATE=
