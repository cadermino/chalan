FROM node:24-alpine
WORKDIR /chalan
COPY ./frontend/package.json ./frontend/package-lock.json ./
RUN npm ci
# Selectivo: sin esto se copiaría el node_modules del host (macOS) sobre el de Linux.
COPY ./frontend/index.html ./frontend/vite.config.mjs ./frontend/postcss.config.js ./frontend/tailwind.config.js ./frontend/.browserslistrc ./
COPY ./frontend/public ./public
COPY ./frontend/src ./src

CMD ["npm", "run", "serve"]
