FROM node:18-alpine as react-build-stage
WORKDIR /app
# Con el lockfile y `npm ci`: instala exactamente las versiones probadas en
# local. Con solo package.json y `npm install`, cada build tomaba la última
# versión que permitiera el ^ (Next 15.5.27 en vez de 15.5.22), sin que nadie
# la hubiera probado.
COPY /frontend-react/package.json /frontend-react/package-lock.json ./
RUN npm ci
COPY /frontend-react .
ARG NEXT_PUBLIC_PLACES_API_KEY
ENV NEXT_PUBLIC_PLACES_API_KEY=$NEXT_PUBLIC_PLACES_API_KEY
ARG NEXT_PUBLIC_CHAT_TENANT_ID
ENV NEXT_PUBLIC_CHAT_TENANT_ID=$NEXT_PUBLIC_CHAT_TENANT_ID
ARG NEXT_PUBLIC_CHAT_API_URL
ENV NEXT_PUBLIC_CHAT_API_URL=$NEXT_PUBLIC_CHAT_API_URL
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build

FROM node:18-alpine
WORKDIR /chalan/frontend-react-standalone
COPY --from=react-build-stage /app/.next/standalone ./
COPY --from=react-build-stage /app/.next/static ./.next/static
COPY --from=react-build-stage /app/public ./public
