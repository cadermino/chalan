FROM node:18-alpine as vue-build-stage
WORKDIR /chalan
ENV NODE_OPTIONS=--openssl-legacy-provider
# Dependencias antes del código, igual que en el stage del backoffice: así un
# cambio de .vue no vuelve a bajar node_modules entero. Es el build más pesado
# del deploy.
COPY /frontend/package.json /frontend/package-lock.json ./
RUN npm ci
COPY /frontend .
RUN npm run build

FROM node:20-alpine as backoffice-build-stage
WORKDIR /app
# Lockfile + `npm ci` por lo mismo que el Next.js (Dockerfile.peru.prod):
# versiones fijas, no la última que permita el ^.
COPY /backoffice/package.json /backoffice/package-lock.json ./
RUN npm ci
COPY /backoffice .
ENV VITE_API_URL=/backoffice-api
ENV VITE_BASE_PATH=/backoffice/
RUN npm run build

FROM nginx:alpine
COPY --from=vue-build-stage /chalan/dist /chalan/frontend/dist
COPY --from=backoffice-build-stage /app/dist /chalan/backoffice/dist
COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx.chalan-prod-peru.conf /etc/nginx/conf.d/
