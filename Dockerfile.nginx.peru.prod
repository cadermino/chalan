FROM node:24-alpine as vue-build-stage
WORKDIR /chalan
# Dependencias antes del código, igual que en el stage del backoffice: así un
# cambio de .vue no vuelve a bajar node_modules entero. Es el build más pesado
# del deploy.
COPY /frontend/package.json /frontend/package-lock.json ./
RUN npm ci
COPY /frontend .
# Reserva con Yape en el modal de agendar (solo Perú; ver PaymentConfirmationModal).
ENV VUE_APP_YAPE_QR_ENABLED=true
RUN npm run build

FROM node:24-alpine as backoffice-build-stage
WORKDIR /app
# Lockfile + `npm ci` por lo mismo que el Next.js (Dockerfile.peru.prod):
# versiones fijas, no la última que permita el ^.
COPY /backoffice/package.json /backoffice/package-lock.json ./
RUN npm ci
COPY /backoffice .
ENV VITE_API_URL=/backoffice-api
ENV VITE_BASE_PATH=/backoffice/
# La key de Google de services-web (NEXT_PUBLIC_PLACES_API_KEY en .env.prod,
# docker-compose-peru.prod.yml): el mapa aproximado del link de las empresas.
ARG VITE_PLACES_API_KEY
ENV VITE_PLACES_API_KEY=$VITE_PLACES_API_KEY
RUN npm run build

FROM nginx:alpine
COPY --from=vue-build-stage /chalan/dist /chalan/frontend/dist
COPY --from=backoffice-build-stage /app/dist /chalan/backoffice/dist
COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx.chalan-prod-peru.conf /etc/nginx/conf.d/
